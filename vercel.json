{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "functions": {
    "api/render.js": { "maxDuration": 300 },
    "api/mail.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/essenza-tuinen", "destination": "/", "permanent": false },
    { "source": "/essenza-tuinen/:path*", "destination": "/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
